{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "一键更新",
  "version": "0.1.0",
  "identifier": "cn.cookies.onekey-updater",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "系统一键更新",
        "width": 1120,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["acrylic", "mica"]
        }
      },
      {
        "label": "settings",
        "title": "设置",
        "url": "settings.html",
        "width": 580,
        "height": 680,
        "minWidth": 480,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["acrylic", "mica"]
        }
      },
      {
        "label": "notify",
        "title": "通知",
        "url": "notify.html",
        "width": 360,
        "height": 100,
        "resizable": false,
        "decorations": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["acrylic"]
        }
      },
      {
        "label": "about",
        "title": "关于",
        "url": "about.html",
        "width": 480,
        "height": 620,
        "minWidth": 420,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["acrylic", "mica"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
